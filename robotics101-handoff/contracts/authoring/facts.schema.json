{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotics101.local/contracts/authoring/facts.schema.json",
  "title": "Fact sheet (§1.2 facts.json, §3.3-3.4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "text",
          "kidText",
          "kind",
          "concept",
          "support",
          "status"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^c-[0-9]{2,3}$"
          },
          "text": {
            "type": "string"
          },
          "kidText": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "definition",
              "mechanism",
              "number",
              "example",
              "history"
            ]
          },
          "concept": {
            "type": "string"
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "exact",
                    "min",
                    "max"
                  ],
                  "default": "exact",
                  "description": "min/max bound a verified range; an episode demo number inside it is allowed (§3.5 rule 4)"
                }
              }
            }
          },
          "support": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "excerpt"
              ],
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 8
                }
              }
            }
          },
          "status": {
            "enum": [
              "verified",
              "single_source",
              "unverified",
              "contradicted"
            ]
          },
          "independence": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "lineClaims": {
      "type": "array",
      "description": "teaching line -> claim ids (source-spec beat indices); kept here, not in the beat (§1.2)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sceneId",
          "beat",
          "claimIds"
        ],
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "beat": {
            "type": "integer",
            "minimum": 0
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^c-[0-9]{2,3}$"
            }
          }
        }
      }
    }
  }
}
