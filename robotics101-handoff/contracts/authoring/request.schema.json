{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotics101.local/contracts/authoring/request.schema.json",
  "title": "Authoring request (PLAN-authoring §1.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episodeNumber"
  ],
  "anyOf": [
    {
      "required": [
        "topicId"
      ]
    },
    {
      "required": [
        "topic"
      ]
    }
  ],
  "properties": {
    "topicId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$"
    },
    "topic": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "episodeNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "ageBand": {
      "enum": [
        "6-9",
        "9-12"
      ],
      "default": "6-9"
    },
    "audience": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    },
    "durationTargetSeconds": {
      "type": "number",
      "minimum": 120,
      "maximum": 900,
      "default": 300
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    },
    "mustInclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "default": []
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "default": []
    },
    "madeForKids": {
      "type": "boolean",
      "default": true
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,47}$"
      },
      "default": [
        "bolt",
        "maya",
        "nib"
      ]
    },
    "budgetUsd": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "default": 8.0
    },
    "mode": {
      "enum": [
        "fixture",
        "record",
        "live"
      ],
      "default": "fixture"
    }
  }
}
