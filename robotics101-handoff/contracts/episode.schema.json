{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotics101.local/contracts/episode.schema.json",
  "title": "Robotics101 EpisodeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "episodeNumber",
    "title",
    "audience",
    "durationTargetSeconds",
    "scenes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "episodeId": {
      "type": "string",
      "pattern": "^ep-[0-9]{3,}$"
    },
    "episodeNumber": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 140
    },
    "audience": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "durationTargetSeconds": {
      "type": "integer",
      "minimum": 120,
      "maximum": 900
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "sourceUrl",
          "verificationStatus"
        ],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "verificationStatus": {
            "enum": [
              "verified",
              "unverified"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneId",
        "sequence",
        "title",
        "educationalObjective",
        "engine",
        "template",
        "durationTargetSeconds",
        "narration",
        "parameters",
        "validation"
      ],
      "properties": {
        "sceneId": {
          "type": "string",
          "minLength": 4
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "educationalObjective": {
          "type": "string",
          "minLength": 5
        },
        "engine": {
          "enum": [
            "manim",
            "blender",
            "static"
          ]
        },
        "template": {
          "type": "string",
          "minLength": 3
        },
        "durationTargetSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "narration": {
          "type": "string",
          "minLength": 8
        },
        "parameters": {
          "type": "object"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiredChecks"
          ],
          "properties": {
            "requiredChecks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "render_success",
                  "video_probe",
                  "labels_visible",
                  "kinematics_consistency",
                  "joint_constraints",
                  "duration_match",
                  "sensor_geometry",
                  "safe_asset"
                ]
              }
            }
          }
        }
      }
    }
  }
}
