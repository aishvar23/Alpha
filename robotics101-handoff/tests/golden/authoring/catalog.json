    "cartoon_robot_checkup": {
      "cannotShow": [
        "non-Bolt robots",
        "part internals"
      ],
      "defaultShots": false,
      "needs": [
        "one line per part naming it"
      ],
      "params": {
        "parts": "subset/order of structure, sensors, actuators, power, controller"
