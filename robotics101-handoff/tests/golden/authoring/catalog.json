      },
      "shows": [
        "sound",
        "pulse",
        "echo",
        "reflect",
        "range",
        "readout",
        "distance"
      ],
      "teaches": [
        "distance_sensor",
        "ultrasonic",
        "echo",
        "sensor_range"
      ]
    },
