      "shows": [
        "parts",
        "part_glow",
        "charging",
        "battery",
        "bar"
      ],
      "teaches": [
        "robot_parts",
        "structure",
        "sensors",
        "actuators",
        "power",
        "controller"
      ]
    },
    "cartoon_robot_family": {
      "cannotShow": [
        "mechanism",
        "numbers"
      ],
      "defaultShots": true,
      "needs": [
        "page_flip sfx before the examples",
        "one line naming each example"
      ],
      "params": {
        "examples": "2-4 example names (vacuum, arm, rover, toaster ...)"
      },
      "shows": [
        "robot_examples",
        "family_album",
        "vacuum",
        "arm_example",
        "rover"
      ],
      "teaches": [
        "what_is_a_robot",
        "robot_examples"
      ]
    },
    "cartoon_rule_board": {
      "cannotShow": [
        "two-rule steering",
        "graph"
      ],
      "defaultShots": true,
      "needs": [
        "a line stating the rule",
        "one line per reading"
      ],
      "params": {
        "readings": "decreasing readings, last < threshold",
