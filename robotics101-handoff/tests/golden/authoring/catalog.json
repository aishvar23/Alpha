      "cannotShow": [
        "light",
        "infrared",
        "surface_black",
        "surface_shiny"
      ],
      "defaultShots": true,
      "needs": [
        "ping sfx",
        "a line with the range",
        "Nib flying past the range"
      ],
      "params": {
        "obstacleDistanceMeters": "Nib's distance in m",
